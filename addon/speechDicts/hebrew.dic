# Biblical Hebrew speech dictionary for Dutch TTS (Tiberian/Erasmian pronunciation).
# Transliterates pointed Hebrew into Dutch-phonetic text before speech.
# Fields: pattern<TAB>replacement<TAB>caseSensitive<TAB>type
# type 0 = ANYWHERE (literal), type 1 = REGEXP.
# BHS/WLC text stores combining marks in Unicode canonical order: the vowel
# sits between a consonant and its dagesh or shin/sin dot. Multi-mark rules
# therefore tolerate intervening marks instead of assuming adjacency.
# Sections cascade: every rule rewrites the output of the previous ones.

# ====================================================================
# Section 1: Strip direction and formatting characters, and invisible
# joiners (CGJ, ZWSP/ZWNJ/ZWJ, word joiner) that some sources insert
# around Hebrew marks to control their ordering. Joiners are only
# stripped next to a Hebrew character: this dictionary is global, and
# emoji ZWJ sequences in other text must stay intact.
# ====================================================================
[\u200E\u200F\u202A-\u202E\u2066-\u2069\uFEFF]		0	1
[\u034F\u200B-\u200D\u2060](?=[\u0590-\u05FF])|(?<=[\u0590-\u05FF])[\u034F\u200B-\u200D\u2060]		0	1

# ====================================================================
# Section 2: Strip cantillation except atnach (U+0591) and zaqef qatan
# (U+0594), plus meteg, rafe, paseq, puncta extraordinaria and nun
# hafukha. Must run before any adjacency-sensitive rule.
# ====================================================================
[\u0592\u0593\u0595-\u05AF\u05BD\u05BF\u05C0\u05C4-\u05C6]		0	1

# ====================================================================
# Section 3: Relocate pause accents to the end of the word.
# Atnach and zaqef qatan mark the stressed syllable mid-word; the pause
# punctuation belongs after the word. The continuation class excludes
# maqaf and sof pasuq so punctuation never crosses a word boundary.
# ====================================================================
\u0591([\u05B0-\u05BC\u05C1\u05C2\u05C7\u05D0-\u05EA]*)	\1;	0	1
\u0594([\u05B0-\u05BC\u05C1\u05C2\u05C7\u05D0-\u05EA]*)	\1,	0	1

# ====================================================================
# Section 4: Shin/sin resolution.
# Sin becomes samech (same phoneme) while tolerating the niqqud that
# canonically sits between shin and the sin dot; all remaining dots
# are shin dots and are stripped, so bare shin renders 'sh' below.
# ====================================================================
ש([\u05B0-\u05BC\u05C7]*)\u05C2	ס\1	0	1
[\u05C1\u05C2]		0	1

# ====================================================================
# Section 5: Furtive patach.
# A patach under word-final chet/ayin/mapiq-he is spoken before it.
# ====================================================================
([חע])\u05B7(?![\u05B0-\u05BC\u05C1\u05C2\u05C7\u05D0-\u05EA])	a\1	0	1
ה\u05B7\u05BC(?![\u05B0-\u05BC\u05C1\u05C2\u05C7\u05D0-\u05EA])	ah	0	1

# ====================================================================
# Section 6: Sheva disambiguation. Order: final, double, closed syllable.
# Rule 1: word-final sheva is silent (also before maqaf and sof pasuq).
# Rule 2: double sheva: first silent, second vocal.
# Rule 3: sheva after a short vowel closes the syllable and is silent;
# the dagesh guard keeps sheva under a dagesh forte letter vocal.
# Accepted limits: word-final double sheva renders 'e'; sheva after
# qamats stays vocal (no qamats qatan heuristic).
# ====================================================================
\u05B0(?![\u05B0-\u05BC\u05C1\u05C2\u05C7\u05D0-\u05EA])		0	1
([\u05D0-\u05EA])\u05B0([\u05D0-\u05EA])\u05B0	\1\2e	0	1
([\u05B4\u05B6\u05B7\u05BB]\u05BC?)([\u05D0-\u05EA])\u05B0(?!\u05BC)	\1\2	0	1

# ====================================================================
# Section 7: Vav matres lectionis (holam-vav, shuruq).
# Adjacency is safe here: a mater vav carries no niqqud of its own, so
# nothing intervenes. A consonantal vav with dagesh forte has its vowel
# in between and falls through to Section 8.
# ====================================================================
וֹ	o	0	0
וּ	oe	0	0

# ====================================================================
# Section 8: Dagesh resolution.
# Gemination doubles the Hebrew letter so the copy flows through the
# later sections; only single-letter outputs double (never sh/ch/ts
# digraphs or the semivowels vav/yod, which Dutch TTS mangles).
# The lookbehind (full vowel or dagesh, not sheva) separates forte
# from lene; BKP forte hardens and doubles, BKP lene hardens only.
# Tav keeps 't' in both states (no spirantization).
# The final rule strips every remaining dagesh: mapiq, lene tav,
# forte in digraphs and semivowels.
# ====================================================================
(?<=[\u05B1-\u05BC\u05C7])([גדזטלמנסקת])([\u05B0-\u05BB\u05C7]?)\u05BC	\1\1\2	0	1
(?<=[\u05B1-\u05BC\u05C7])ב([\u05B0-\u05BB\u05C7]?)\u05BC	bb\1	0	1
(?<=[\u05B1-\u05BC\u05C7])כ([\u05B0-\u05BB\u05C7]?)\u05BC	kk\1	0	1
(?<=[\u05B1-\u05BC\u05C7])פ([\u05B0-\u05BB\u05C7]?)\u05BC	pp\1	0	1
ב([\u05B0-\u05BB\u05C7]?)\u05BC	b\1	0	1
כ([\u05B0-\u05BB\u05C7]?)\u05BC	k\1	0	1
ך([\u05B0-\u05BB\u05C7]?)\u05BC	k\1	0	1
פ([\u05B0-\u05BB\u05C7]?)\u05BC	p\1	0	1
ף([\u05B0-\u05BB\u05C7]?)\u05BC	p\1	0	1
ּ		0	0

# ====================================================================
# Section 9: Yod matres lectionis, with guards against consonantal yod
# (a yod carrying its own niqqud or dagesh). Runs after Section 8 so a
# doubled letter has restored vowel-yod adjacency.
# ====================================================================
\u05B8יו(?![\u05B0-\u05BC\u05C1\u05C2\u05C7\u05D0-\u05EA])	aaw	0	1
\u05B5י(?![\u05B0-\u05BC\u05C7])	ee	0	1
\u05B6י(?![\u05B0-\u05BC\u05C7])	ê	0	1
\u05B4י(?![\u05B0-\u05BC\u05C7])	ie	0	1
\u05B9י(?![\u05B0-\u05BC\u05C7])	o	0	1

# ====================================================================
# Section 10: Consonants (single chars, including final/sofit forms).
# ====================================================================
א	'	0	0
ב	v	0	0
ג	g	0	0
ד	d	0	0
ה	h	0	0
ו	w	0	0
ז	z	0	0
ח	ch	0	0
ט	t	0	0
י	j	0	0
כ	ch	0	0
ך	ch	0	0
ל	l	0	0
מ	m	0	0
ם	m	0	0
נ	n	0	0
ן	n	0	0
ס	s	0	0
ע	'	0	0
פ	f	0	0
ף	f	0	0
צ	ts	0	0
ץ	ts	0	0
ק	k	0	0
ר	r	0	0
ש	sh	0	0
ת	t	0	0

# ====================================================================
# Section 11: Vowel points (niqqud).
# The e-vowels split three ways, judged by Dutch orthography:
# 'e' is vocal sheva (Dutch unstressed e is schwa), 'ê' is segol and
# hataf segol, 'ee' is tsere. Sheva here is the vocal fallback for
# what Section 6 left in place.
# Hiriq is 'ie', the Dutch spelling of /i/; the hiriq-yod mater rule
# above exists to silence the yod, not to change the vowel.
# ====================================================================
ְ	e	0	0
ַ	a	0	0
ָ	aa	0	0
ׇ	o	0	0
ֶ	ê	0	0
ֵ	ee	0	0
ִ	ie	0	0
ֹ	o	0	0
ֺ	o	0	0
ֻ	oe	0	0
ֱ	ê	0	0
ֲ	a	0	0
ֳ	o	0	0

# ====================================================================
# Section 12: Hebrew punctuation.
# ====================================================================
׃	.	0	0
־	-	0	0
