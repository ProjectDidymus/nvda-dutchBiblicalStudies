# Polytonic Greek speech dictionary for Dutch TTS (Erasmian pronunciation).
# Transliterates polytonic Greek into Dutch-phonetic text before speech.
# Fields: pattern<TAB>replacement<TAB>caseSensitive<TAB>type
# This file uses REGEXP (type 1) for all entries so it remains compatible
# with NVDA versions predating the split of anywhere asper diphthongs into
# START_OF_WORD + WORD pairs.
# Regex equivalents (from NVDA speechDictHandler/types.py):
#   WORD          -> \bX\b
#   PART_OF_WORD  -> (?<=\w)X|X(?=\w)
#   START_OF_WORD -> \bX(?=\w)
# Order matters: multi-char / breathing rules must precede single-char rules.

# ====================================================================
# Section 1: Diphthongs with asper on second vowel (word-initial).
# Asper moves to the front of the whole diphthong.
# Anywhere asper diphthongs are expanded to \bX\b | \bX(?=\w) forms.
# ====================================================================
\bαἱ(?=\w)	hai	0	1
\bαἱ\b	hai	0	1
\bαἵ(?=\w)	hái	0	1
\bαἳ(?=\w)	hai	0	1
\bαἷ(?=\w)	hai	0	1
\bεἱ(?=\w)	hei	0	1
\bεἵ(?=\w)	héi	0	1
\bεἳ(?=\w)	hei	0	1
\bεἷ(?=\w)	hei	0	1
\bοἱ(?=\w)	hoi	0	1
\bοἱ\b	hoi	0	1
\bοἵ(?=\w)	hói	0	1
\bοἳ(?=\w)	hoi	0	1
\bοἷ(?=\w)	hoi	0	1
\bαὑ(?=\w)	hau	0	1
\bαὕ(?=\w)	háu	0	1
\bαὓ(?=\w)	hau	0	1
\bαὗ(?=\w)	hau	0	1
\bαὗ\b	hau	0	1
\bεὑ(?=\w)	heu	0	1
\bεὕ(?=\w)	héu	0	1
\bεὓ(?=\w)	heu	0	1
\bεὗ(?=\w)	heu	0	1
\bοὑ(?=\w)	hoe	0	1
\bοὕ(?=\w)	hóe	0	1
\bοὓ(?=\w)	hoe	0	1
\bοὗ(?=\w)	hoe	0	1
\bοὗ\b	hoe	0	1
\bυἱ(?=\w)	hui	0	1
\bυἵ(?=\w)	húi	0	1
\bυἳ(?=\w)	hui	0	1
\bυἷ(?=\w)	hui	0	1

# ====================================================================
# Section 2: Diphthongs with lenis on second vowel (word-initial).
# Lenis is silent; acute on second vowel moves to Dutch acute.
# ====================================================================
\bαἰ(?=\w)	ai	0	1
\bαἴ(?=\w)	ái	0	1
\bαἲ(?=\w)	ai	0	1
\bαἶ(?=\w)	ai	0	1
\bεἰ(?=\w)	ei	0	1
\bεἴ(?=\w)	éi	0	1
\bεἲ(?=\w)	ei	0	1
\bεἶ(?=\w)	ei	0	1
\bοἰ(?=\w)	oi	0	1
\bοἴ(?=\w)	ói	0	1
\bοἲ(?=\w)	oi	0	1
\bοἶ(?=\w)	oi	0	1
\bαὐ(?=\w)	au	0	1
\bαὔ(?=\w)	áu	0	1
\bαὒ(?=\w)	au	0	1
\bαὖ(?=\w)	au	0	1
\bεὐ(?=\w)	eu	0	1
\bεὔ(?=\w)	éu	0	1
\bεὒ(?=\w)	eu	0	1
\bεὖ(?=\w)	eu	0	1
\bοὐ(?=\w)	oe	0	1
\bοὔ(?=\w)	óe	0	1
\bοὒ(?=\w)	oe	0	1
\bοὖ(?=\w)	oe	0	1
\bυἰ(?=\w)	ui	0	1
\bυἴ(?=\w)	úi	0	1
\bυἲ(?=\w)	ui	0	1
\bυἶ(?=\w)	ui	0	1

# ====================================================================
# Section 3: Iota-subscriptum vowels with asper (word-initial).
# ====================================================================
\bᾁ(?=\w)	hai	0	1
\bᾃ(?=\w)	hai	0	1
\bᾅ(?=\w)	hái	0	1
\bᾇ(?=\w)	hai	0	1
\bᾑ(?=\w)	hèi	0	1
\bᾓ(?=\w)	hèi	0	1
