(?<=\w)οί|οί(?=\w)	ói	0	1
(?<=\w)υί|υί(?=\w)	úi	0	1

# ====================================================================
# Section 8: Gamma-nasal clusters (pronounced as [ng]).
# Must precede bare gamma rule.
# ====================================================================
(?<=\w)γγ|γγ(?=\w)	ng	0	1
(?<=\w)γκ|γκ(?=\w)	nk	0	1
(?<=\w)γχ|γχ(?=\w)	nch	0	1
(?<=\w)γξ|γξ(?=\w)	nks	0	1

