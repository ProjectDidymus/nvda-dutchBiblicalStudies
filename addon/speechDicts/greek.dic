# ====================================================================
# Section 7: Bare diphthongs (no breathing).
# Accent on second vowel transfers to Dutch acute.
# ====================================================================
(?<=\w)αυ|αυ(?=\w)	au	0	1
(?<=\w)ευ|ευ(?=\w)	eu	0	1
(?<=\w)ου|ου(?=\w)	oe	0	1
(?<=\w)οῦ|οῦ(?=\w)	oe	0	1
(?<=\w)οὺ|οὺ(?=\w)	oe	0	1
(?<=\w)αι|αι(?=\w)	ai	0	1
(?<=\w)ει|ει(?=\w)	ei	0	1
(?<=\w)οι|οι(?=\w)	oi	0	1
(?<=\w)υι|υι(?=\w)	ui	0	1
