\bὓ(?=\w)	hu	0	1
\bὗ(?=\w)	hu	0	1
\bὡ(?=\w)	hoo	0	1
\bὥ(?=\w)	hóó	0	1
\bὣ(?=\w)	hoo	0	1
\bὧ(?=\w)	hoo	0	1

# ====================================================================
# Section 6: Single vowels with lenis (word-initial).
# Lenis is silent; accent transfers to Dutch acute where present.
# ====================================================================
\bἀ(?=\w)	a	0	1
\bἄ(?=\w)	á	0	1
\bἂ(?=\w)	a	0	1
\bἆ(?=\w)	a	0	1
\bἐ(?=\w)	e	0	1
